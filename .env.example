# ── AaharAI NutriSync — Environment Configuration ──────────────────
# Copy this to backend/.env and fill in your values.
# NEVER commit backend/.env to version control.
# Run `make setup` to auto-generate this with a secure SECRET_KEY.

# ─── Application ────────────────────────────────────────────────────
APP_ENV=development
# Options: development | staging | production
# In production: set LOG_FORMAT=json for structured log aggregation

# ─── Logging ────────────────────────────────────────────────────────
LOG_FORMAT=text
# Options: text (human-readable) | json (for production log shippers)
LOG_LEVEL=INFO

# ─── Auth / Security ────────────────────────────────────────────────
# REQUIRED: Generate a strong key with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ─── Database ───────────────────────────────────────────────────────
# Leave empty to use SQLite (good for development)
DATABASE_URL=

# PostgreSQL (for production):
# DATABASE_URL=postgresql://nutrisync:password@localhost:5432/nutrisync
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=nutrisync
POSTGRES_PASSWORD=
POSTGRES_DB=nutrisync

# ─── Local AI — Ollama ──────────────────────────────────────────────
# Install: https://ollama.ai
# Models:  ollama pull gemma3:4b && ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ─── Cloud AI Fallback — Groq (Free Tier) ───────────────────────────
# Get key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ─── LLM Behavior ───────────────────────────────────────────────────
# Seconds before retrying Ollama health check
LLM_FALLBACK_RETRY_SECONDS=60

# ─── RAG Configuration ──────────────────────────────────────────────
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.3

# ─── CORS ───────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. In production:
# CORS_ORIGINS=["https://your-domain.com"]
# CORS_ORIGINS=["http://localhost:3001","http://localhost:3000"]

# ─── Redis (optional — for Celery background tasks) ──────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_TTL=300

# ─── Debug ──────────────────────────────────────────────────────────
# Never set DEBUG=true in production
DEBUG=false
